# Copy to .env and replace the placeholders. Never commit .env.

# Comma-separated gateway API keys accepted from clients. In production each key
# must be at least 32 characters; generate one with: openssl rand -hex 32
GATEWAY_API_KEYS=replace-with-a-random-key

GATEWAY_ENVIRONMENT=development
GATEWAY_CONFIG_FILE=config/gateway.toml
GATEWAY_LOG_LEVEL=INFO
GATEWAY_MAX_REQUEST_BYTES=1048576

# Provider credentials, referenced by api_key_env in the configuration file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOCK_UPSTREAM_API_KEY=mock-upstream-key
